{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Éditeur : {{ auteur.nomPrenom }}</h1>
    {% if auteur is not null %}
        <div class="card mb-1 m-auto">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between">
                    <h4 class="mb-1">{{ auteur.nomPrenom }}</h4>
                    <small class="text-muted">Identifiant : {{ auteur.id }}</small>
                </div>
                <div class="d-flex justify-content-between card-text">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Date de naissance : {{ auteur.getDateNaissance() | date('d/m/Y') }}</li>
                        <li class="list-group-item">Date de décès : {{ auteur.getDateDeces() is not null ? auteur.getDateDeces() | date('d/m/Y') : '-' }}</li>
                    </ul>
                    <p><small>Nationalité : {{ auteur.getNationalite().getLabel() }}</small></p>
                </div>
            </div>
        </div>
    {% else %}
        <div>Éditeur non trouvé</div>
    {% endif %}
    <a href="{{ path('app_admin_auteur') }}" class="btn btn-primary">Retour à la liste</a>
</div>
{% endblock %}
