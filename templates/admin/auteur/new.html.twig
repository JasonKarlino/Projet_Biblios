{% extends 'base.html.twig' %}

{% set action = app.current_route == 'app_admin_auteur_new' ? 'Ajout' : 'Édition' %}

{% block title %}{{ action }} d'auteur{% endblock %}

{% block body %}
<section class="container px-4">
    <div class="w-50 m-auto">
        <h1>{{ action }} d'auteur</h1>

        {{ form_start(form) }}
            {{ form_row(form.nomPrenom, {'label': 'Nom et prénom de l\'auteur'}) }}
            {{ form_row(form.date_naissance, {'label': 'Date de naissance de l\'auteur'}) }}
            {{ form_row(form.date_deces, {'label': 'Date de décès de l\'auteur'}) }}
            {{ form_row(form.nationalite, {'label': 'Nationalité de l\'auteur'}) }}
            {{ form_row(form.livres, {'label': 'Livres de l\'auteur'}) }}
                <button class="btn btn-primary">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</section>
{% endblock %}
