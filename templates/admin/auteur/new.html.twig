{% extends 'form.html.twig' %}

{% block title %}Ajout d'auteur{% endblock %}

{% block body %}
<section class="container px-4">
    <div class="w-50 m-auto">
        <h1>Ajout d'auteur</h1>

        {{ form_start(form) }}
        {{ form_row(form.nomPrenom, {label: 'Nom et Prénoms'}) }}
        {{ form_row(form.date_naissance, {label: 'Date de naissance'}) }}
        {{ form_row(form.date_deces, {label: 'Date de déces'}) }}
        {{ form_row(form.nationalite, {label: 'Nationalité'}) }}
        {{ form_row(form.livres, {label: 'Livres'}) }}
        <button class="btn btn-primary">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</section>
{% endblock %}
