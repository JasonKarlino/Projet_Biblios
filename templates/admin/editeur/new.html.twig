{% extends 'form.html.twig' %}

{% block title %}Ajout d'éditeur{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 500px; width: 95%; font: 18px/1.5 container; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Ajout d'Editeur</h1>

    {{ form_start(form) }}
    {{ form_row(form.nomPrenom, {label: 'Nom et Prénoms'}) }}
    {{ form_row(form.livres, label: 'Livres') }}
    {{ form_end(form) }}
    
</div>
{% endblock %}
