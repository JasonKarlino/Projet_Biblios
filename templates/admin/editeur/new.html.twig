{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 650px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Nouvel éditeur</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}} ) }}
    {{ form_row(form.nomPrenom, {'label': 'Nom et prénom de l\'éditeur'}) }}
    {{ form_row(form.livres, {'label': 'Livres de l\'éditeur'}) }}
    <button class="btn btn-primary">Enregistrer l'éditeur</button>
    {{ form_end(form) }}
</div>
{% endblock %}
