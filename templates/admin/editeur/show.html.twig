{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Éditeur : {{ editeur.nomPrenom }}</h1>
    {% if editeur is not null %}
        <div class="card mb-1 m-auto">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between">
                    <h4 class="mb-1">{{ editeur.nomPrenom }}</h4>
                    <small class="text-muted">Identifiant : {{ editeur.id }}</small>
                </div>
            </div>
        </div>
    {% else %}
        <div>Éditeur non trouvé</div>
    {% endif %}
    <a href="{{ path('app_admin_editeur') }}" class="btn btn-primary">Retour à la liste</a>
</div>
{% endblock %}
