{% extends 'base.html.twig' %}

{% block title %}Liste de livres{% endblock %}

{% block body %}
<section class="py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bolder">Catalogue des livres</h1>
        <p class="lead fw-normal text-muted mb-0">Découvrez tous nos ouvrages</p>
    </div>
    <div class="container px-4 px-lg-5 mt-5">
        <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4">
            {% for livre in livres %}
                <div class="col mb-5">
                    <div class="card h-100 shadow-sm border border-1 border-secondary">
                        <!-- Product image-->
                        <img class="card-img-top" src="{{ livre.image }}" alt="..." style="height: 230px; object-fit: cover;" />
                        <!-- Product details-->
                        <div class="card-body p-4">
                            <div class="text-center">
                                <!-- Product name-->
                                <h5 class="fw-bolder">{{ livre.titre }}</h5>
                                <!-- Product price-->
                                <p class="text-muted">{{ livre.prix }} FCFA</p>
                            </div>
                            <div class="d-flex justify-content-center small text-warning mb-2">
                                {% set rating = 0 %}
                                {% if livre.etat == 'Neuf' %}{% set rating = 5 %}
                                {% elseif livre.etat == 'Bon état' %}{% set rating = 4 %}
                                {% elseif livre.etat == 'État moyen' %}{% set rating = 3 %}
                                {% elseif livre.etat == 'Mauvais état' %}{% set rating = 2 %}
                                {% elseif livre.etat == 'Abîmé' %}{% set rating = 1 %}
                                {% endif %}
                                {% for i in 1..5 %}
                                    {% if i <= rating %}
                                        <i class="bi bi-star-fill"></i>
                                    {% else %}
                                        <i class="bi bi-star"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <!-- Product actions-->
                            <div class="text-center mt-auto">
                                <a href="{{ path('app_admin_livre_show', {id: livre.id}) }}" class="btn btn-outline-dark mt-auto">Voir détails</a>
                            </div>
                        </div>  
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p>Aucun livre trouvé.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}
