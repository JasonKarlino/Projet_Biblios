{% extends 'base.html.twig' %}

{% block title %}Liste de livres{% endblock %}

{% block body %}
<section class="container px-4">
    <h1>Liste de livres</h1>
    <ul class="list-group list-group-flush">
            {% for livre in livres %}
                <div class="card mb-1">
                    <div class="card-body">
                        <div class="card-title d-flex justify-content-between">
                            <a href="{{ path('app_admin_livre_show', {id: livre.id}) }}" class="stretched-link link-dark">
                                <h4 class="mb-1">{{ livre.titre }}</h4>
                            </a>
                            <small class="text-muted">Identifiant : {{ livre.id }}</small>
                        </div>
                    </div>
                </div>
            {% else %}
                <li>Aucun livre trouvé.</li>
            {% endfor %}
        </ul>
        {{ pagerfanta(livres) }}
    </div>
</section>

{% endblock %}
