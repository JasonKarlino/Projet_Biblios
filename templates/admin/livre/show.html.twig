{% extends 'base.html.twig' %}

{% block title %}Livre{% endblock %}

{% block body %}
<section class="container px-4">
    <h1>Livre : </h1>

    {% if livre is not null %}
        <div class="card mb-1 m-auto">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between">
                    <h4 class="mb-1">{{ livre.titre }}</h4>
                    <small class="text-muted">Identifiant : {{ livre.id }}</small>
                </div>
                <div class="d-flex justify-content-between card-text">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><h5>Date d'édition : </h5>{{ livre.getDateSortie()|date('d M Y') }}</li>
                        <li class="list-group-item"><h5>ISBN : </h5>{{ livre.getNumeroISBN() }}</li>
                        <li class="list-group-item">
                            <h5>Auteur : </h5>
                            <ul class="list-group list-group-flush">
                                {% for auteur in livre.auteurs %}
                                    <li class="list-group-item">
                                        <a href="{{ path('app_admin_auteur_show', {id: auteur.id}) }}">{{ auteur.nomPrenom }}</a>
                                    </li>
                                {% else %}
                                    <li class="list-group-item">Pas d'auteur connu</li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li class="list-group-item">
                            <h5>Éditeur : </h5>
                            <a href="{{ path('app_admin_editeur_show', {id: livre.editeur.id}) }}">{{ livre.editeur.nomPrenom }}</a>
                        </li>
                        <li class="list-group-item"><h5>Nombre de pages : </h5>{{ livre.nombrePages }}</li>
                        <li class="list-group-item"><h5>Synopsis : </h5>{{ livre.synopsis }}</li>
                    </ul>
                    <div>
                        <img src="{{ livre.image }}" alt="Couverture de {{ livre.titre }}">
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div>Livre non trouvé</div>
    {% endif %}
    <a href="{{ path('app_admin_livre_index') }}" class="btn btn-primary">Retour</a>
    <a href="{{ path('app_admin_livre_edit', {id: livre.id}) }}" class="btn btn-warning">Éditer</a>
</section>
{% endblock %}