{% extends 'base.html.twig' %}

{% set titre = livre is null ? 'Livre inconnu' : livre.titre %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
<section class="py-5">
    {% if livre is not null %}
        <div class="container px-4 px-lg-5 my-5">
            <div class="row gx-4 gx-lg-5 align-items-start">
                <div class="col-md-6">
                    {# {% set badgeColor = 'bg-dark' %}
                    {% if livre.statut.value == 'disponible' %}{% set badgeColor = 'bg-success text-white' %}
                    {% elseif livre.statut.value == 'emprunté' %}{% set badgeColor = 'bg-warning text-dark' %}
                    {% elseif livre.statut.value == 'indisponible' %}{% set badgeColor = 'bg-danger text-white' %}
                    {% endif %}

                    <div class="position-relative text-center mb-4">
                        <div class="badge {{ badgeColor }} position-absolute" style="top: 0.5rem; right: 2rem; z-index: 10; font-size: 1rem;">
                            {{ livre.statut.getLabel() }}
                        </div>
                        <img class="card-img-top mb-3 w-75" src="{{ livre.image }}" alt="Couverture de {{ livre.titre }}" />
                    </div> #}

                    <img class="card-img-top mb-3 w-75" src="{{ livre.image }}" alt="Couverture de {{ livre.titre }}" />
                    <h1 class="display-5 fw-bolder">{{ titre }}</h1>
                    <div class="fs-5">ISBN: {{ livre.numeroISBN ?: 'Non renseigné' }}</div>
                    <div class="fs-5">
                        <span>Auteur(s): {{ livre.auteurs|map(a => a.nomPrenom)|join(', ') }}</span>
                    </div>
                    <div class="fs-5">
                        <span>Éditeur: {{ livre.editeur.nomPrenom }}</span>
                    </div>
                    <div class="fs-5">
                        <span>{{ livre.nombrePages }}{{ livre.nombrePages is not null ? ' pages' }}</span>
                        <span> - {{ livre.dateEdition|date('d M Y') }}</span>
                    </div>
                    {# <div class="fs-5 mb-5">
                        <span>Statut: {{ livre.status.getLabel() }}</span>
                    </div>                     #}
                    {# <li class="list-group-item">
                        <h5>Auteur(s) : 
                            {% for auteur in livre.auteurs %}
                                <a>{{ auteur.nomPrenom }}</a>{% if not loop.last %}{% if loop.revindex0 == 1 %} & {% else %}, {% endif %}{% endif %}
                            {% endfor %}
                            {% if livre.auteurs|length == 0 %}
                                Pas d'auteur connu
                            {% endif %}
                        </h5>
                    </li> #}
                    <div class="fs-5">
                        <span>Catégorie : {{ livre.categorie is not null ? livre.categorie.getLabel() : 'Non classé' }}</span>
                    </div>
                    <br>
                    {# <h5>Synopsis : </h5>
                    <p class="lead" style="text-align: justify;">{{ livre.synopsis }}</p> #}
                    <div class="d-flex small text-warning mb-2">
                        {% set rating = 0 %}
                        {% if livre.etat == 'Neuf' %}{% set rating = 5 %}
                        {% elseif livre.etat == 'Bon état' %}{% set rating = 4 %}
                        {% elseif livre.etat == 'État moyen' %}{% set rating = 3 %}
                        {% elseif livre.etat == 'Mauvais état' %}{% set rating = 2 %}
                        {% elseif livre.etat == 'Abîmé' %}{% set rating = 1 %}
                        {% endif %}
                        {% for i in 1..5 %}
                            {% if i <= rating %}
                                <i class="bi bi-star-fill"></i>
                            {% else %}
                                <i class="bi bi-star"></i>
                            {% endif %}
                        {% endfor %}
                        <span class="ms-2 text-dark">({{ livre.etat }})</span>
                    </div>
                    <div class="fs-5 mb-5">
                        {#<span class="text-decoration-line-through">$45.00</span>#}
                        <p>{{ livre.prix }} FCFA</p>
                    </div>
                    <div class="d-flex">
                        <input class="form-control text-center me-3" id="inputQuantity" type="number" value="{{ livre.quantite ?? 0 }}" min="0" aria-label="Quantité disponible" readonly style="max-width: 5rem" />
                        {# <button class="btn btn-outline-dark flex-shrink-0" type="button">
                            <i class="bi-cart-fill me-1"></i>
                            Ajouter au panier
                        </button> #}
                    </div>
                </div>
                <div class="col-md-6 mt-4 mt-md-0">
                    <h2><strong>Synopsis</strong></h2>
                    <p class="lead" style="text-align: justify;">{{ livre.synopsis }}</p>
                </div>
            </div>
        </div>
    {% else %}
        <div>Livre non trouvé</div>
    {% endif %}
    <div class="d-flex justify-content-center gap-2">
        <a href="{{ path('app_admin_livre_index') }}" class="btn btn-outline-dark flex-shrink-0">Retour au catalogue</a>
        <a href="{{ path('app_admin_livre_edit', {id: livre.id}) }}" class="btn btn-warning">Éditer</a>
    </div>
    
</section>
{% endblock %}