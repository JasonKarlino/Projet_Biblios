{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 650px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Ajout d'un livre</h1>

        {{ form_start(form) }}
            {{ form_row(form.titre, {'label': 'Titre du livre'}) }}
            {{ form_row(form.image, {'label': 'Image du livre'}) }}
            {{ form_row(form.numeroISBN, {'label': 'Numéro ISBN du livre'}) }}
            {{ form_row(form.date_sortie, {'label': 'Date de sortie du livre'}) }}
            {{ form_row(form.nombre_pages, {'label': 'Nombre de pages du livre'}) }}
            {{ form_row(form.synopsis, {'label': 'Synopsis du livre'}) }}
            {{ form_row(form.statut, {'label': 'Statut du livre'}) }}
            {{ form_row(form.editeur, {'label': 'Éditeur du livre'}) }}
            {{ form_row(form.auteurs, {'label': 'Auteurs du livre'}) }}
                <button class="btn btn-primary">Enregistrer</button>
        {{ form_end(form) }}
</div>
{% endblock %}
